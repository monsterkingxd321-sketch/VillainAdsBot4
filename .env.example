API_HASH=abcdef0123456789abcdef0123456789
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required)
# MongoDB connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/...)
# -----------------------------------------------------------------
